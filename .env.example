# =============================================================
# .env.example — Plantilla de variables de entorno
# Copiar como .env.dev / .env.qa / .env.prd y completar
# NUNCA subir .env.dev, .env.qa ni .env.prd al repo
# =============================================================

SPRING_PROFILES_ACTIVE=dev

# ── Base de datos ─────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/nombre_bd?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_64_characters_here
JWT_EXPIRATION=86400000

# ── CORS ──────────────────────────────────────────
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── Mail – SMTP ───────────────────────────────────
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=noreply@tudominio.com
MAIL_PASSWORD=
MAIL_FROM=noreply@tudominio.com

# ── Código de verificación ────────────────────────
VERIFICATION_CODE_EXPIRATION_MINUTES=10

# ── AWS S3 ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=nombre-bucket
AWS_S3_PREFIX=               # ← aquí, ej: pdfs/ o vouchers/

TWILIO_ACCOUNT_SID=REEMPLAZAR
TWILIO_AUTH_TOKEN=REEMPLAZAR
TWILIO_WHATSAPP_FROM=REEMPLAZAR

# ── Enlace corto del voucher (WhatsApp/correo) ────
# Dominio público donde corre este backend (o el reverse-proxy que apunta a él).
# SIN "/" final. Se usa para armar: {APP_PUBLIC_BASE_URL}/v/{correlativo}
APP_PUBLIC_BASE_URL=https://vouchers.tudominio.com

RATE_LIMIT_MAX_ATTEMPTS=REEMPLAZAR
RATE_LIMIT_BLOCK_DURATION_MS=REEMPLAZAR
RATE_LIMIT_WINDOW_MS=REEMPLAZAR